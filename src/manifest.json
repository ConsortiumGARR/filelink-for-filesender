{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.0.0",
  "description": "__MSG_extensionDescription__",
  "default_locale": "en",
  "icons": {
    "16": "icons/filesender-16.png",
    "32": "icons/filesender-32.png",
    "48": "icons/filesender-48.png",
    "64": "icons/filesender-64.png",
    "96": "icons/filesender-96.png",
    "128": "icons/filesender-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "{e4525bf0-d34d-41b7-95a0-e71aa8fbde32}",
      "strict_min_version": "128.0"
    }
  },
  "background": {
    "scripts": [
      "lib/filesender.js",
      "lib/fscrypto.js",
      "background/log.js",
      "background/background.js",
      "background/windows.js",
      "background/cleanup.js"
    ]
  },
  "cloud_file": {
    "name": "__MSG_serviceName__",
    "management_url": "management/management.html",
    "reuse_uploads": false
  },
  "permissions": ["compose", "notifications", "storage"],
  "host_permissions": ["https://*/*"]
}
