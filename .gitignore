# Build output
dist/
*.xpi

# Python (test/, tools/)
__pycache__/
*.pyc
.venv/
.ruff_cache/

# Fixtures generated by test/files/make_fixtures.sh (large; the 200 GiB one is
# sparse and git would try to read all of it)
test/files/too-large-200GiB.bin
test/files/ok-*.bin

# Generated by test/signing/gen.py and test/crypto/gen.py from the ground-truth
# reference.py/crypto_reference.py; regenerated fresh by every test/check.sh run,
# never committed, so they can never go stale relative to the reference
test/signing/vectors.json
test/crypto/vectors.json

# Node (webext-linter, when run locally instead of only in CI)
node_modules/
npm-debug.log*

# Editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
